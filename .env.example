# OpenRouter (default backend)
OPENROUTER_API_KEY=

# LLM backend: openrouter (default) or ollama.
# For a remote Ollama host, point the OpenAI-compatible base URL at http://HOST:11434/v1.
MCBUILD_LLM_BACKEND=openrouter
MCBUILD_BASE_URL=
MCBUILD_API_KEY=

# Optional: exported by /mcbuild registry export on the NeoForge server.
MCBUILD_SERVER_REGISTRY=

# Optional: directory scanned by mcbuild-scan-mods.
MCBUILD_MODS_DIR=

# Optional: override scanner manifest and imported resource-pack cache locations.
MCBUILD_MOD_ASSET_INDEX=
MCBUILD_MOD_ASSET_CACHE=
